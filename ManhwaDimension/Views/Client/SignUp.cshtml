    <script type="text/javascript">
 const currentPath = window.location.href;
 const publicRoutes = ["sign-in", "sign-up", "forgot-password", "reset-password"];
 const isPublicRoute = publicRoutes.some(route => currentPath.includes(route));
 if (!isPublicRoute) {
     const token = localStorage.token;
     if (!token)
         window.location.href = "@Url.Action("signin", "admin")";
     else
         preloadToken(token);
 }

 async function preloadToken(token) {
     try {
         const payload = JSON.parse(atob(token.split('.')[1]));
         const exp = payload.exp;
         const now = Math.floor(Date.now() / 1000);

         // Token sẽ hết hạn trong 5 phút tới
         if (exp - now < 300) {
             const data = {
                 accessToken: localStorage.token,
                 refreshToken: localStorage.refreshToken
             };
             const res = await fetch("https://localhost:7148/api/v1/auth/refresh-token", {
                 method: "POST",
                 headers: { "Content-Type": "application/json" },
                 body: JSON.stringify(data)
             });

             if (res.ok) {
                 const data = await res.json();
                 localStorage.token = data.resources.accessToken;
                 localStorage.refreshToken = data.resources.refreshToken;
             }

         }
     } catch (e) {
         console.error(e);
     }
 }
    </script>
