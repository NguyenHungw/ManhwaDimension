            }

            100% {
                transform: rotate(360deg);
            }
        }

        [data-bs-theme=light] [data-kt-app-layout=dark-sidebar] #kt_app_sidebar .theme-light-show {
            display: none !important;
        }

        [data-bs-theme=light] [data-kt-app-layout=dark-sidebar] #kt_app_sidebar .theme-dark-show {
