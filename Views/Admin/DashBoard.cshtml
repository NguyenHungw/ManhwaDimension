@{
    Layout = "~/Views/Shared/_Admin_Layout.cshtml";
    ViewData["Title"] = "Dashboard - GENESTORY";
}
@* <style>

    .card .card-body {
        background-color: #FFFFFF33;
    }


    .search-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
        gap: 10px;
    }

    .right-controls {
        display: flex;
        align-items: center;
        gap: 10px;
        background-color: #FFFFFF99;
        border-radius: 4px;
    }



    .input-wrapper {
        position: relative;
        height: 42px;
        display: flex;
    }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        width: 18px;
        height: 18px;
        object-fit: contain;
    }

    .search-input {
        backdrop-filter: none;
        width: 100%;
        padding: 5px 40px 5px 40px; /* sửa 10px thành 40px */
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 4px;
        background-color: rgba(255, 255, 255, 0.3);
        color: #000;
    }


    .svg-box {
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        /* phần CSS mới */
        padding: 5px;
        display: flex;
        background-color: #FCC960;
        justify-content: center;
        pointer-events: none;
        border-radius: 3px;
    }

    .left-buttons-wrapper {
        display: flex;
        justify-content: space-between;
        align-items: center;

        border: 1px solid #fff;
        padding: 2px;
        border-radius: 6px;
        background-color: #FFFFFF99;
    }

    .menu-btn {
        flex: 1;
        margin: 0 2px;
        padding: 6px 0;
        border-radius: 4px;
        cursor: pointer;
        width:150px;
        height: 36px;
        font-size: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        color: black;
    }

        .menu-btn:hover {
            background-color: #FCC960;
        }

        .menu-btn.active {
            background-color: #FCC960;
        }

    #kt_app_content_container {
        /* padding-top: 10px; */
        /* padding-bottom: 30px; */
        padding: 1.25rem;
    }
    /* Mobile + Tablet */
    @@media (max-width: 991px) {

        .left-buttons-wrapper {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid #fff;
            padding: 2px;
            border-radius: 6px;
            background-color: #FFFFFF99;
            width: 58%;
        }


        .search-container {
            flex-direction: column; /* Đẩy nhóm bên phải xuống dòng */
            align-items: stretch !important;
            gap: 20px !important; /* Tăng khoảng cách giữa 2 nhóm */
        }

        .right-controls {
            width: 58%; /* Chiếm toàn bộ chiều ngang */
            justify-content: space-between;
        }

            .right-controls .input-wrapper {
                flex-grow: 1;
            }

            .right-controls .search-input {
                width: 100%; /* Input rộng 100% */
            }
    }

        @@media (max-width: 575.98px) {
            /* XS: mobile rất nhỏ */
            .right-controls {
                width: 100%; /* Chiếm toàn bộ chiều ngang */
                justify-content: space-between;
            }

            .left-buttons-wrapper {
                display: flex;
                justify-content: space-between;
                align-items: center;
                border: 1px solid #fff;
                padding: 2px;
                border-radius: 6px;
                background-color: #FFFFFF99;
                width: 100%;
            }

        }
</style>
