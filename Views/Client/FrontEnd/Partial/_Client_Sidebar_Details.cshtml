<script>
    $(document).ready(function () {
        const profile = JSON.parse(localStorage.getItem("profile"));
        console.log("check profile", profile);
        if (profile && profile.photo) {
            document.getElementById("profilePhoto").src = profile.photo;
        } else {
            console.log("Không tìm thấy ảnh trong profile");
        }

        // Ghi ra console URL ảnh
        const photoUrl = profile?.photo;
        console.log("photoUrl", photoUrl);


        const path = window.location.pathname;
        const urlParams = new URLSearchParams(location.search);

        // Ưu tiên lấy accountId từ query (trang chi tiết), fallback sang localStorage (trang tổng quan)
        let accountId = urlParams.get("accountId");
        if (!accountId) {
            try {
                const profileRaw = localStorage.getItem("profile");
                if (profileRaw) {
                    const profile = JSON.parse(profileRaw);
                    accountId = profile?.id || profile?.accountId || null;
                }
            } catch (e) {
                console.warn("Cannot parse profile from localStorage in _Client_Sidebar_Details:", e);
            }
        }


        if (path.includes("danh-sach-ket-qua-thong-ke")) {
            if (!accountId) {
                console.warn("Không tìm được accountId khi load sidebar (tổng quan).");
                return;
            }
            // Truyền diseaseKey = null, để hàm tự chọn bệnh có nguy cơ cao nhất
            loadSidebarDetails(accountId, null);
            return;
        }
        // Trang tổng quan: lấy bệnh có nguy cơ cao nhất cho sidebar
        if (path.includes("qr-code")) {
            if (!accountId) {
                console.warn("Không tìm được accountId khi load sidebar (tổng quan).");
                return;
            }
            // Truyền diseaseKey = null, để hàm tự chọn bệnh có nguy cơ cao nhất
            loadSidebarDetails(accountId, null);
            return;
        }
        if (path.includes("dap-ung-thuoc")) {
            if (!accountId) {
                console.warn("Không tìm được accountId khi load sidebar (tổng quan).");
                return;
            }
            // Truyền diseaseKey = null, để hàm tự chọn bệnh có nguy cơ cao nhất
            loadSidebarDetails(accountId, null);
            return;
        }
        if (path.includes("thong-tin-thuoc")) {
            if (!accountId) {
                console.warn("Không tìm được accountId khi load sidebar (tổng quan).");
                return;
            }
            // Truyền diseaseKey = null, để hàm tự chọn bệnh có nguy cơ cao nhất
            loadSidebarDetails(accountId, null);
            return;
        }
        // Trang chi tiết bệnh
        if (path.includes("ket-qua-thong-ke")) {
            const diseaseKey = urlParams.get("d");
            if (!accountId || !diseaseKey) {
                console.warn("Thiếu accountId hoặc diseaseKey khi load sidebar (chi tiết bệnh).", {
                    accountId,
                    diseaseKey
                });
                return;
            }
            loadSidebarDetails(accountId, diseaseKey);
        }
    });

    // Toggle & responsive cho metric-list
    const toggleBtn = $("#toggleMetrics");
    const metricSection = $("#metricSection");
    let metricsCollapsed = false;

    function applyMetricResponsive() {
        const isSmallScreen = window.innerWidth < 992; // < lg

        if (isSmallScreen) {
            // Mobile + tablet: ẩn mặc định, cho phép mở rộng
            metricsCollapsed = true;
            metricSection.addClass("d-none");
            toggleBtn.text("Mở rộng");
        } else {
            // Desktop: luôn hiển thị
            metricsCollapsed = false;
            metricSection.removeClass("d-none");
            toggleBtn.text("Thu gọn");
        }
    }

    // Áp dụng khi load lần đầu
    applyMetricResponsive();

    // Áp dụng lại khi resize
    $(window).on("resize", function () {
        applyMetricResponsive();
    });

    // Click để mở rộng / thu gọn
    toggleBtn.on("click", function (e) {
        e.preventDefault();
        metricsCollapsed = !metricsCollapsed;
        metricSection.toggleClass("d-none", metricsCollapsed);
        toggleBtn.text(metricsCollapsed ? "Mở rộng" : "Thu gọn");
    });


    function loadSidebarDetails(accountId, diseaseKey) {

        const apiCall = $.ajax({
            url: `/profile/api/statistics/${accountId}`,
            method: "GET",
            dataType: "json"
        });


        const mappingCall = $.ajax({
            url: "/js/disease_metric_mapping.json",
            method: "GET",
            dataType: "json"
        });

        $.when(apiCall, mappingCall).done((apiRes, mappingRes) => {

            const api = apiRes[0] || {};
            const mapping = mappingRes[0] || {};

            const resources = api.resources || {};
            const scores = resources.scores || [];
            const metricCards = resources.metricCards || [];
            const riskMarkers = resources.riskMarkers || [];

            //window.userImage.src = '/images/userdefault.jpg';
            if (window.userImage) {

                const photoUrl = resources.profile?.avatar;
                console.log("photo", photoUrl);
                window.userImage.src = photoUrl || '/images/userdefault.jpg';

            }

            const chartData = resources;

            $(document).trigger('initRiskChart', chartData);


            // Nếu không truyền diseaseKey (trang tổng quan) -> chọn bệnh có nguy cơ cao nhất
            if (!diseaseKey) {
                if (!scores.length) {
                    console.warn("Không có scores để xác định bệnh nguy cơ cao nhất.");
                    return;
                }

                const riskPriority = {
                    poor: 3,       // Nguy cơ cao
                    moderate: 2,   // Nguy cơ trung bình
                    good: 1        // Nguy cơ thấp
                };

                const topScore = scores.slice().sort((a, b) => {
                    const aLevel = (a.riskLevel || '').toLowerCase();
                    const bLevel = (b.riskLevel || '').toLowerCase();
                    const aPri = riskPriority[aLevel] || 0;
                    const bPri = riskPriority[bLevel] || 0;

                    // Ưu tiên riskLevel: poor > moderate > good
                    if (aPri !== bPri) return bPri - aPri;

                    // Nếu cùng level thì sort theo scoreValue giảm dần
                    const aScore = typeof a.scoreValue === 'number' ? a.scoreValue : 0;
                    const bScore = typeof b.scoreValue === 'number' ? b.scoreValue : 0;
                    return bScore - aScore;
                })[0];

                diseaseKey = topScore?.diseaseKey;
            }


            // mapping name giữ nguyên
            const diseaseInfo = mapping[diseaseKey];

            if (!diseaseInfo) {
                console.warn("Không tìm thấy diseaseInfo", diseaseKey);
                return;
            }

            // Set tên bệnh
            $("#disease-title").text(diseaseInfo.name || "");
            $("#ten-benh").text(diseaseInfo.name || "");
            $("#ten-static").text(diseaseInfo.name || "");
            $("#id-name").text(resources.profile.accountName || "")


            const scoreItem = scores.find(s => s.diseaseKey === diseaseKey);
            const riskScore = scoreItem ? Number(scoreItem.scoreValue) || 0 : 0;
            const riskPercent = convertScoreToPercent(riskScore);

            const labelRiskLevel = scoreItem.riskLevel;
            console.log("Risk level:", labelRiskLevel);

            // Map gradient màu
            const mapGradient = {
                good: "bg-success-gradient",
                moderate: "bg-success-gradient",
                poor: "bg-warning-gradient",
                high: "bg-danger-gradient",
                bad: "bg-danger-gradient"
            };

            // Map tiếng Việt
            const riskLevelText = {
                good: "Tốt",
                moderate: "Trung bình",
                poor: "Kém",
                high: "Cao",
                bad: "Xấu"
            };

            // Lấy class gradient, fallback nếu không khớp key
            const gradientClass = mapGradient[labelRiskLevel] || "bg-secondary-gradient";

            // Gán màu
            document.getElementById("rateRiskLevel").classList.add(gradientClass);

            // Gán chữ tiếng Việt
            document.getElementById("rateRiskLevel").textContent = riskLevelText[labelRiskLevel] || "Không xác định";


            var url = new URL(window.location.href);
            if ("/ket-qua-thong-ke" != url.pathname) {
                $(".disease-card").addClass("d-none");
            }

            $("#disease-risk-percent").text(riskPercent + "%");

            // Render metric theo mapping
            $("#metric-list").empty();
            (diseaseInfo.metrics || []).forEach(code => {
                renderMetricByKey(code, metricCards);
            });

            // Set màu risk level dựa vào riskScore
            const riskLevel =
                riskScore >= 7 ? "red" :
                    riskScore >= 4 ? "orange" :
                        "green";

            if (window.setRiskLevel) {
                window.setRiskLevel(riskLevel);
            }

            let clinicalPercent = 0;

            if (scoreItem) {
                const scoreName = (scoreItem.name || '').trim().toLowerCase();

                //  match đúng clinical theo tên bệnh
                let clinicalMarker = riskMarkers.find(m =>
                    (m.type || '').toLowerCase() === 'clinical' &&
                    (m.label || '').trim().toLowerCase() === scoreName
                );

                // nếu không tìm được mà chỉ có 1 clinical trong riskMarkers thì dùng luôn nó
                if (!clinicalMarker) {
                    const clinicalList = riskMarkers.filter(m =>
                        (m.type || '').toLowerCase() === 'clinical'
                    );
                    if (clinicalList.length === 1) {
                        clinicalMarker = clinicalList[0];
                    }
                }

                if (clinicalMarker) {
                    const clinicalScore = Number(clinicalMarker.value) || 0;
                    clinicalPercent = convertScoreToPercent(clinicalScore);
                }
            }

            // Nếu có phần trăm nguy cơ lâm sàng riêng muốn show:
            if (clinicalPercent > 0) {
                $("#clinical-risk-percent").text(clinicalPercent + "%");
            }

            if (window.setRiskBar) {
                const markers = [];

                // marker di truyền
                markers.push({
                    value: riskPercent,
                    label: riskPercent + '%',
                    type: 1002 // map trong setRiskBar để ra màu vàng
                });

                // marker lâm sàng
                if (clinicalPercent > 0) {
                    markers.push({
                        value: clinicalPercent,
                        label: clinicalPercent + '%',
                        type: 1001 // map trong setRiskBar để ra màu xanh
                    });
                }

                console.log('setRiskBar markers = ', markers);

                window.setRiskBar(
                    {greenEnd: 8, orangeEnd: 16}, // ngưỡng đang dùng
                    markers
                );
            }

        }).fail(err => {
            console.error("loadSidebarDetails AJAX error:", err);
        });
    }

    // Tìm card theo metricKey rồi render
    function renderMetricByKey(metricKey, metricCards) {
        const card = metricCards.find(m => m.metricKey === metricKey);
        if (!card) return;

        renderMetricFromApi(card);
    }

    //  mapMetricToUI và append vào #metric-list
    function renderMetricFromApi(card) {
        const html = mapMetricToUI(card);
        if (!html) return;

        $("#metric-list").append(html);
    }


    function convertScoreToPercent(score) {
        switch (score) {
            case 0:
                return 3;
            case 1:
                return 7;
            case 2:
                return 11;
            case 3:
                return 15;
            case 4:
                return 22;
            case 5:
                return 30;
            case 6:
                return 40;
            case 7:
                return 55;
            case 8:
                return 70;
            case 9:
                return 85;
            case 10:
                return 95;
            default:
                return 0;
        }
    }

    function mapMetricToUI(card) {
        if (!card) return "";

        const name = card.name || card.metricKey || "";
        const valueRaw = card.valueNumeric ?? card.valueText ?? "";
        const unit = card.unit ?? "";
        const rangeLow = card.rangeLow ?? "∞";
        const rangeHigh = card.rangeHigh ?? "∞";
        const desc = card.description ?? "";
        const statusLabel = card.statusLabel ?? "";

        const statusLevel = (card.statusLevel || "").toLowerCase().trim();

        // làm tròn tới số gần nhất
        const numericValue = Math.round(Number(valueRaw) || 0);

        const thresholdsRaw = card.thresholds || [];

        if (!thresholdsRaw.length) {
            // không có threshold thì tuỳ bạn
            return "";
        }

        const isNumber = (v) => typeof v === "number" && !isNaN(v);

        // Hàm lấy giá trị dùng để sort trên trục số
        function getSortValue(t) {
            const min = t.minValue;
            const max = t.maxValue;

            // khoảng có cả min & max (ví dụ: 135–145) -> lấy tâm
            if (isNumber(min) && isNumber(max)) {
                return (min + max) / 2;
            }

            // chỉ có max (ví dụ: < 135) -> đặt nó nằm TRƯỚC max
            if (!isNumber(min) && isNumber(max)) {
                return max - 1e6; // số rất nhỏ hơn max
            }

            // chỉ có min (ví dụ: > 145) -> đặt nó nằm SAU min
            if (isNumber(min) && !isNumber(max)) {
                return min + 1e6; // số rất lớn hơn min
            }

            // không có min/max -> cho về 0
            return 0;
        }

        const thresholds = thresholdsRaw.slice().sort((a, b) => {
            const va = getSortValue(a);
            const vb = getSortValue(b);

            if (va !== vb) return va - vb;

            // nếu vô tình trùng sortValue thì mới dùng priority làm tie-break
            const pa = a.priority ?? 999;
            const pb = b.priority ?? 999;
            return pa - pb;
        });


        const n = thresholds.length;
        const segmentWidth = 100 / n;

        // === tìm threshold active theo numericValue ===
        // === tìm threshold active theo numericValue ===
        let activeIndex = 0;
        const activeThreshold = thresholds.find((t, idx) => {
            const min = isNumber(t.minValue) ? t.minValue : -Infinity;
            const max = isNumber(t.maxValue) ? t.maxValue : Infinity;

            const hit = numericValue >= min && numericValue <= max;
            if (hit) activeIndex = idx;
            return hit;
        }) || thresholds[0];

        // =====================
        // TÍNH LẠI VỊ TRÍ THANH KIM
        // =====================
        const segStart = segmentWidth * activeIndex;       // % bắt đầu segment active
        const segEnd = segmentWidth * (activeIndex + 1); // % kết thúc segment active

        let percent;  // vị trí cuối cùng của thanh kim (0–100)

        let tMin = isNumber(activeThreshold.minValue) ? activeThreshold.minValue : null;
        let tMax = isNumber(activeThreshold.maxValue) ? activeThreshold.maxValue : null;

        function clamp01(v) {
            return Math.max(0, Math.min(1, v));
        }

        if (tMin !== null && tMax !== null) {
            // ====== có đủ min & max ======
            if (tMin === tMax) {
                // 2 giá trị bằng nhau: coi là 1 mức
                if (numericValue <= tMin) {
                    percent = segStart;      // nhỏ hơn / bằng -> đầu segment
                } else {
                    percent = segEnd;        // lớn hơn -> cuối segment
                }
            } else {
                // nội suy trong [min, max]
                let ratio = (numericValue - tMin) / (tMax - tMin);
                ratio = clamp01(ratio);
                percent = segStart + ratio * segmentWidth;
            }
        } else if (tMin === null && tMax !== null) {
            // ====== chỉ có max, ví dụ: < 500 ======
            // coi như khoảng [0, max]
            let ratio = numericValue / (tMax || 1);
            ratio = clamp01(ratio);
            percent = segStart + ratio * segmentWidth;
        } else if (tMin !== null && tMax === null) {
            // ====== chỉ có min, ví dụ: > 300 ======
            // nếu <= min thì sát đầu; > min thì dịch dần về cuối
            let ratio;
            if (numericValue <= tMin) {
                ratio = 0;
            } else {
                // xấp xỉ: coi khoảng [min, 2*min] là full segment
                const approxMax = tMin * 2 || (tMin + 1);
                ratio = (numericValue - tMin) / (approxMax - tMin);
            }
            ratio = clamp01(ratio);
            percent = segStart + ratio * segmentWidth;
        } else {
            // không có min & max: giữ giữa segment
            percent = segStart + segmentWidth * 0.5;
        }


        // màu calss cho label
        const finalLevel = getLevelFromThreshold(activeThreshold, statusLevel);
        let colorClass = "";
        switch (finalLevel) {
            case "success":
                colorClass = "bg-green-gradient";
                break;
            case "danger":
                colorClass = "bg-red-gradient";
                break;
            case "warning":
                colorClass = "bg-orange-gradient";
                break;
            case "neutral":
            default:
                colorClass = "bg-gray-gradient";
                break;
        }

        function getLevelFromThreshold(threshold, fallbackStatusLevel) {
            const type = (threshold.thresholdType || "").toLowerCase();
            const fallback = (fallbackStatusLevel || "").toLowerCase();

            // dựa trên thresholdType
            if (/normal|optimal|good|g1|male_normal|approx_normal/.test(type)) {
                return "success";
            }

            if (/borderline|near_optimal|prediabetes|g2|g3|g4|g5|moderate|suggestive|gray_zone|suspicious|approx/.test(type)) {
                return "warning";
            }

            if (/high|very_high|elevated|hyper|hypo|low|gout|critical/.test(type)) {
                return "danger";
            }

            // 2. Nếu thresholdType không cos, fallback về statusLevel từ API
            if (["success", "warning", "danger", "neutral"].includes(fallback)) {
                return fallback;
            }

            // 3. Cuối cùng nữa thì neutral
            return "neutral";
        }


        //  Lưu lại màu segment cho từng ngưỡng

        // xử lý màu cho thành segment màu hiện tại = > gradient
        const segmentColors = [];
        let segmentsHtml = "";

        thresholds.forEach((t, idx) => {
            const color = t.color || "#ffffff"; // màu gốc của segment
            segmentColors[idx] = color;

            // làm tối & làm sáng dựa trên màu gốc
            const darker = shadeColor(color, -0.8);  // tương đương "đen" nhưng theo màu
            const lighter = shadeColor(color, 0.4);  // tương đương "trắng" nhưng theo màu

            segmentsHtml += `
                <div class="segment"
                     style="
                        width:${segmentWidth}%;
                        background: linear-gradient(
                            to right,
                            ${darker} 0%,      /* trái: màu tối hơn */
                            ${color} 35%,      /* giữa: màu gốc */
                            ${color} 55%,      /* giữ màu gốc */
                            ${lighter} 100%    /* phải: màu sáng hơn */
                        );
                     ">
                </div>
            `;
        });


        // color dạng "#rrggbb", percent từ -1 → 1
        function shadeColor(color, percent) {
            // bỏ dấu #
            let col = color.replace('#', '');
            if (col.length === 3) {
                // chuyển #rgb → #rrggbb
                col = col.split('').map(ch => ch + ch).join('');
            }

            const num = parseInt(col, 16);
            let r = (num >> 16) & 255;
            let g = (num >> 8) & 255;
            let b = num & 255;

            // percent > 0: làm sáng, < 0: làm tối
            r = Math.round(r + (255 - r) * percent);
            g = Math.round(g + (255 - g) * percent);
            b = Math.round(b + (255 - b) * percent);

            // clamp
            r = Math.max(0, Math.min(255, r));
            g = Math.max(0, Math.min(255, g));
            b = Math.max(0, Math.min(255, b));

            const toHex = (v) => v.toString(16).padStart(2, '0');
            return `#${toHex(r)}${toHex(g)}${toHex(b)}`;
        }


        let activeSegmentColor = segmentColors[activeIndex];

        // fallback nếu threshold không có màu
        if (!activeSegmentColor || activeSegmentColor === "#ffffff") {
            if (statusLevel === "success") activeSegmentColor = "#36bf5f";
            else if (statusLevel === "danger" || statusLevel === "warning") activeSegmentColor = "#ff4b4b";
            else activeSegmentColor = "#f9a825"; // cam
        }

        // dùng lại shadeColor cho label
        const labelDarker = shadeColor(activeSegmentColor, -0.8); // tối bên trái
        const labelLighter = shadeColor(activeSegmentColor, 0.4); // sáng bên phải


        // helper format text cho từng ngưỡng
        function formatThresholdText(t) {
            const min = t.minValue;
            const max = t.maxValue;

            if (isNumber(min) && isNumber(max)) { // ngưỡng ở giữa
                return `${max}`;        // Sodium: hiện "145"
            }
            if (isNumber(min) && !isNumber(max)) {
                return `> ${min}`;
            }
            if (!isNumber(min) && isNumber(max)) {
                return `< ${max}`;
            }
            // return t.thresholdLabel || "";
            return t.thresholdLabel || "";
        }


        // block div cho các ngưỡng
        let thresholdsDynamicHtml = "";
        thresholds.forEach((t, idx) => {
            // tâm mỗi ngưỡng thanh kim
            const left = segmentWidth * (idx + 1);

            const tickColor = segmentColors[idx];
            const text = formatThresholdText(t);

            thresholdsDynamicHtml += `
                <div class="threshold-item" style="left:${left}%;">
                    <div class="tick-mark" style="background:${tickColor};"></div>
                    <span class="threshold-text">${text}</span>
                </div>
            `;
        });
        const thresholdsBlockHtml = `
                <div class="thresholds">
                    ${thresholdsDynamicHtml}
                </div>
                <div class='text-center'>(${unit})</div>

            `;

        return `
                 <div class="health-container d-flex flex-column gap-1">
                                                <span class="fw-bold">
                                                    ${name}
                                                </span>
                                                <div class="d-flex flex-row align-items-center gap-2">
                                                    <div class="label-custom rounded-1 ${colorClass} fs-18px py-1 px-4 text-center"
                                                     style="
                                                        background: linear-gradient(
                                                            to right,
                                                            ${labelDarker} 0%,
                                                            ${activeSegmentColor} 35%,
                                                            ${activeSegmentColor} 55%,
                                                            ${labelLighter} 100%
                                                        );
                                                     ">
                                                        ${numericValue}
                                                    </div>
                                                    <div class="label-numberic d-flex justify-content-between">
                                                    <span class="fw-bold ">
                                                        ${statusLabel}


                                                    </span>
                                                        <i class="hoicham-label-icon fs-12px textcenter d-flex  ">
                                                        <img src="assets/media/icons/hoicham.svg" alt="" />
                                                    </i>
                                                    </div>

                                                </div>
                                                <span class="custom-desc fs-12px">
                                                ${desc}

                                                </span>

                                                <div class="figma-risk-widget">

                                                    <div class="risk-bar-container">
                                                        <!-- Thanh tiến trình với 3 đoạn màu -->
                                                        <div class="risk-progress-bar">
                                                           ${segmentsHtml}
                                                        </div>

                                                        <!-- Marker giá trị 210 -->
                                                        <div class="value-indicator" style="left: ${percent}%;">
                                                            <div class="value-pin">
                                                                    <span>${numericValue}</span>

                                                                    <svg xmlns="http://www.w3.org/2000/svg"
                                                                         width="30"
                                                                         height="36"
                                                                         class="pin-svg"
                                                                         style="color:${activeSegmentColor}
                                                                         ">

                                                                        <mask id="pin-mask" fill="white">
                                                                            <path
                                                                                d="M9.25684 1.14258C12.0005 0.00547218 15.02 -0.291576 17.9326 0.289062C20.8456 0.869857
                                                                                23.5212 2.30257 25.6191 4.40527C28.4252 7.22692 30 11.045 30 15.0244C29.9999 19.0036 28.425
                                                                                22.821 25.6191 25.6426L15.6279 35.6338C15.5455 35.7162 15.4475 35.7816 15.3398 35.8262C15.2321
                                                                                35.8708 15.1166 35.8945 15 35.8945C14.8834 35.8945 14.7679 35.8708 14.6602 35.8262C14.5525
                                                                                35.7816 14.4545 35.7162 14.3721 35.6338L4.38086 25.6426C2.98492 24.2503 1.87894 22.595 1.12695
