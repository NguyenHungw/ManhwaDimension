@{
    Layout = null;
}
<style>
    .hoicham-label-icon img {
        height: 20px;
        width: 20px;
    }

    .threshold-text {
        display: flex;
        flex-direction: column;
    }

    /* 1) class quyết định màu */
    .bg-orange-gradient {
        --pin-color: #FEAC52;
    }

    .bg-green-gradient {
        --pin-color: #22c55e;
    }

    .bg-red-gradient {
        --pin-color: #ef4444;
    }

    /* 2) áp màu vào SVG */
    .value-pin {
        color: var(--pin-color); /* currentColor = SVG màu này */
    }

    /* path chính */
    .value-pin svg .pin-shape {
        fill: currentColor;
    }

    /* 3) circle sync màu */
    .value-circle {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--circle-color, #ccc); /* mặc định */
    }

    /* các class gradient bạn đang dùng ở chỗ khác (nếu có) */
    .bg-orange-gradient {
        background: linear-gradient(135deg, #FEAC52, #F95638);
    }

    .bg-green-gradient {
        background: linear-gradient(135deg, #34C759, #28A745);
    }

    .bg-red-gradient {
        background: linear-gradient(135deg, #FF3B30, #C82333);
    }

    /* KHI dùng các class này trên SVG:
                           - tắt background
                           - dùng chúng để set COLOR -> ăn vào fill="currentColor"
                        */
    .pin-svg.bg-orange-gradient {
        background: none;
        color: #F95638;
    }

    .pin-svg.bg-green-gradient {
        background: none;
        color: #34C759;
    }

    .pin-svg.bg-red-gradient {
        background: none;
        color: #FF3B30;
    }

    .bg-green-gradient {
        background: linear-gradient(#34c759, #28a745);
    }

    .bg-red-gradient {
        background: linear-gradient(#ff3b30, #c82333);
    }

    .bg-orange-gradient {
        background: linear-gradient(#ff9500, #ff7f00);
    }


    .bg-orange-gradient .pin-shape {
        fill: #F95638;
    }

    .bg-green-gradient .pin-shape {
        fill: #34C759;
    }

    .bg-red-gradient .pin-shape {
        fill: #FF3B30;
    }

    .label-custom {
        white-space: nowrap;
        width: 60.66px;
        min-width: 60.66px;
        max-width: 60.66px;
    }

    .figma-risk-widget {
        margin-top: 0px;
        padding-top: 0px;
    }

    .custom-desc {
        height: 88px;
    }

    .risk-progress-bar {
        position: relative;
        display: flex;
        width: 100%;
        height: 10px;
        border-radius: 999px;
        overflow: hidden;
        background: #f5f5f5; /* nền chung phía sau */
    }

    .segment {
        height: 100%;
        border-right: 1px solid #e0e0e0; /* để đoạn trắng vẫn phân biệt được */
    }

    @* *@
    .thresholds {
        position: relative;
        margin-top: 8px;
        height: 35px;
    }

    .threshold-item {
        position: absolute;
        transform: translateX(-50%);
        text-align: center;
        font-size: 11px;
    }

    .tick-mark {
        width: 3px;
        height: 10px;
        margin: 0 auto 3px;
        border-radius: 2px;
    }

    .bg-gray-gradient {
        /* ví dụ */
        background: linear-gradient(90deg, #9e9e9e, #bdbdbd);
        color: #fff;
    }

    .badge-risk {
        text-overflow: ellipsis;
        white-space: nowrap;
        overflow: hidden;
    }

    .badge-protect {
        text-overflow: ellipsis;
        white-space: nowrap;
        overflow: hidden;
    }

    .disease-card {
        position: relative;
    }

    .hoicham-icon {
        position: absolute;
        top: 4px;
        right: 4px;
    }


    @*Hoi cham*@
    .hoicham-wrapper {
        position: absolute;
        display: inline-block;
        top: 4px;
        right: 4px;
    }

    .hoicham-icon img {
        /* width: 28px; */
        height: 20px;
        cursor: pointer;
    }

    .hoicham-tooltip {
        position: relative;
        top: -120px;
        left: 50%;
        transform: translateX(-50%);
        background: white;
        padding: 12px 16px;
        border-radius: 8px;
        box-shadow: 0px 4px 12px rgba(0, 0, 0, 0.15);
        width: 220px;
        display: none;
        z-index: 2147483647; /* max */
    }

    /* Hiện tooltip khi hover icon */
    .hoicham-wrapper:hover .hoicham-tooltip {
        display: block;
    }

    /* Mũi tên nhỏ bên dưới */
    .hoicham-tooltip::after {
        content: "";
        position: absolute;
        top: -6px;
        left: 50%;
        transform: translateX(-50%);
        border-width: 6px;
        border-style: solid;
        border-color: transparent transparent white transparent;
    }

    /* Mỗi dòng trong tooltip */
    .hoicham-tooltip .item {
        display: flex;
        align-items: center;
        margin-bottom: 8px;
        font-size: 16px;
    }

    .hoicham-tooltip .item:last-child {
        margin-bottom: 0;
    }

    .color {
        width: 22px;
        height: 22px;
        border-radius: 6px;
        margin-right: 10px;
    }

    .color.normal {
        background: #60D992;
    }

    .color.mid {
        background: #F46C3A;
    }

    .color.high {
        background: #D94477;
    }


    @*Hồ sơ bệnh*@
    .health-profile-popover .popover-body {
        padding: 0;
    }

    .health-profile-popover-content .badge {
        font-size: 0.85rem;
        padding: 0.5rem 0.75rem;
    }

    .health-profile-popover-content .progress {
        border-radius: 10px;
    }

    .health-profile-popover-content .progress-bar {
        border-radius: 10px;
    }

    .legend-box {
        width: 20px;
        height: 20px;
        border-radius: 6px;
        display: inline-block;
        flex-shrink: 0;
    }


    .bg-success-gradient {
        background: linear-gradient(127.1deg, #3D9C6F 8.34%, #69EC9F 89.68%);
    }

    .bg-warning-gradient {
        background: linear-gradient(234.81deg, #FEAC52 13.06%, #F95638 79.35%);
    }

    .bg-danger-gradient {
        background: linear-gradient(142.04deg, #CE3853 0.3%, #E45585 75.3%);
    }

    .card .card-body {
        background-color: #FFFFFF66;
    }

    .label-numberic {
        width: 100%;
    }

    .hoicham-label-icon {
        cursor: pointer;
    }

    .qrcode {
        cursor: pointer;
    }
</style>
