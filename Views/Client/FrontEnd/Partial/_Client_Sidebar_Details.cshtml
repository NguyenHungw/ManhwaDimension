    $(document).ready(function () {
        const popoverContent = `

              <div class="health-profile-popover-content p-4" style="min-width: 400px; max-width: 500px;">
            <div class="health-profile-popover">
              <div class="d-flex flex-column gap-2 p-1">
                <div class="d-flex align-items-center gap-2">
                  <span class="legend-box bg-success-gradient"></span>
                  <span class="fw-semibold text-gray-800">Ngưỡng bình thường</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <span class="legend-box bg-warning-gradient"></span>
                  <span class="fw-semibold text-gray-800">Ngưỡng cận cao</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <span class="legend-box bg-danger-gradient"></span>
                  <span class="fw-semibold text-gray-800">Ngưỡng cao</span>
                </div>
              </div>
          </div>
              </div>
            `;

        const popoverTrigger = document.getElementById('healthProfileBtn');
        if (popoverTrigger) {
            const popover = new bootstrap.Popover(popoverTrigger, {
                content: popoverContent,
                html: true,
                placement: 'top',
                trigger: 'click',
                customClass: 'health-profile-popover'
            });

            $(document).on('click', function (e) {
                if (!$(e.target).closest('#healthProfileBtn').length &&
                    !$(e.target).closest('.popover').length) {
                    popover.hide();
                }
            });
        }
    });

