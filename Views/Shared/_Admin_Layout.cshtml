    @* Metadata and Libraries *@
    <partial name="Admin/FrontEnd/_Admin_Library" />
    <style>
        #kt_app_main {
            background-size: 120% 100%;
            background-repeat: no-repeat;
            background-position: right;
        }

        #kt_app_content_container {
            padding-top: 30px;
            padding-bottom: 30px;
        }

        @@media (max-width: 991px) {
            #kt_app_main {
                overflow-y: scroll;
            }
        }

        /* Custom Sidebar Background */
        /* Custom Sidebar Background */
        #kt_app_sidebar {
            background: linear-gradient(180deg, #1e1e2d 0%, #151521 100%) !important;
            border-right: 1px solid rgba(255, 255, 255, 0.05);
        }

        /* Sidebar Header (Logo area) */
        #kt_app_sidebar_logo {
            background: #1e1e2d !important;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        /* Sidebar Toggle Button Customization */
        #kt_app_sidebar_toggle {
            background-color: #1e1e2d !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            color: #ffffff !important;
        }

        /* Hiệu ứng hover cho menu item khi có background custom */
        .app-sidebar .menu-link:hover {
            background-color: rgba(255, 255, 255, 0.05) !important;
        }
    </style>
