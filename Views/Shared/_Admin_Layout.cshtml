<!--begin::Body-->
@* Cấu hình giao diện chính *@
<body id="kt_app_body"
      data-kt-app-header-fixed="true"
      data-kt-app-sidebar-enabled="true" 
      data-kt-app-sidebar-fixed="true" 
      data-kt-app-sidebar-hoverable="true"
      data-kt-app-sidebar-push-header="true" 
      data-kt-app-sidebar-push-toolbar="true"
      data-kt-app-sidebar-push-footer="true" 
      data-kt-app-toolbar-enabled="true" 
      class="app-default">

    <!--begin::Theme mode setup on page load-->
    <script>
        var defaultThemeMode = "light";
        var themeMode;
        if (document.documentElement) {
            if (document.documentElement.hasAttribute("data-bs-theme-mode")) {
                themeMode = document.documentElement.getAttribute("data-bs-theme-mode");
            } else {
                if (localStorage.getItem("data-bs-theme") !== null) {
                    themeMode = localStorage.getItem("data-bs-theme");
                } else {
                    themeMode = defaultThemeMode;
                }
            }

            if (themeMode === "system") {
                themeMode = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            }

            document.documentElement.setAttribute("data-bs-theme", themeMode);
        }</script>
    <!--end::Theme mode setup on page load-->
    <!--Begin::Google Tag Manager (noscript) -->
    <noscript>
        <iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5FS8GGP" height="0" width="0"
                style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!--End::Google Tag Manager (noscript) -->
    @* Page Loader - Hiển thị khi đang tải trang *@
    <div class="page-loader d-flex flex-column justify-content-center align-items-center">
        <div class="d-flex align-items-center">
            <img alt="Logo" class="theme-light-show h-50px" src="">
            <img alt="Logo" class="theme-dark-show h-50px" src="">
        </div>

        <div class="d-flex align-items-center mt-5">
            <span class="spinner-border text-primary" role="status"></span>
            <span class="text-muted fs-6 fw-semibold ms-5">Đang tải...</span>
        </div>
    </div>
    @* Khởi tạo ứng dựng (App Root) *@
    <div class="d-flex flex-column flex-root app-root" id="kt_app_root">
        @* Trang chính (Page Container) *@
        <div class="app-page  flex-column flex-column-fluid " id="kt_app_page">
            
            @* Thành phần: Header (Thanh đầu trang) *@
            <!--begin::Header-->
            <partial name="Admin/FrontEnd/_Admin_Layout_Header" />
            <!--end::Header-->

            @* Thành phần: Wrapper (Bao gồm Sidebar và nội dung chính) *@
            <!--begin::Wrapper-->
            <div class="app-wrapper  flex-column flex-row-fluid " id="kt_app_wrapper">
                
                @* Thành phần: Sidebar (Thanh menu trái) *@
                <!--begin::Sidebar-->
                <partial name="Admin/FrontEnd/_Admin_Layout_Sidebar_Hospital" />
                <partial name="Admin/FrontEnd/_Admin_Layout_Sidebar_Production" />
                <!--end::Sidebar-->

                @* Thành phần: Main Content (Nội dung chính của trang) *@
                <!--begin::Main-->
                <div class="app-main flex-column flex-row-fluid" id="kt_app_main">
                    <div class="d-flex flex-column flex-column-fluid">
                        @RenderBody()
                    </div>
                </div>
                <!--end:::Main-->
            </div>
            <!--end::Wrapper-->
        </div>
        <!--end::Page-->
    </div>
    <!--end::App-->
    <!--End: begin app -->
    @* Thành phần: Các cửa sổ chức năng (Modals & Drawers) *@
    <!--begin::Modals & Drawers-->
    <!--begin::Modals-->
    <!--end::Modals-->
    <script src="~/admin/assets/js/shared/config.js" asp-append-version="true"></script>
    @RenderSection("Scripts", required: false)
    <partial name="Admin/FrontEnd/_Admin_Javascript" />
</body>
